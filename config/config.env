# User-editable remote-dev defaults.

REMOTE_DEV_NODE_VERSION="22.19.0"
REMOTE_DEV_PYTHON_DEFAULT="3.12"
REMOTE_DEV_PYTHON_EXTRA="3.11"

# Leave blank unless your tailnet policy permits the requested tags.
REMOTE_DEV_TAILSCALE_TAGS=""
REMOTE_DEV_TAILSCALE_HOSTNAME=""
REMOTE_DEV_ENABLE_TAILSCALE_SSH="0"

# AI agent stack (install with --with-agents, finish with `remote-dev agents`).
# Tool versions come from versions.json in the agent config repository.
REMOTE_DEV_AGENT_CONFIG_REPOSITORY="chrismaree/open-code-config"
REMOTE_DEV_OPENCHAMBER_PORT="3000"
REMOTE_DEV_GITLEAKS_VERSION="8.30.1"
